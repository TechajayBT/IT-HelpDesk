# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Environment variables — NEVER commit these ────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Build output ──────────────────────────────────────────────────────────────
build/
dist/
frontend/build/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
backend/logs/

# ── Uploads — actual user files should not be committed ──────────────────────
backend/uploads/
!backend/uploads/.gitkeep

# ── Coverage reports ──────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Testing ───────────────────────────────────────────────────────────────────
/backend/tests/integration/*.html

# ── Misc ─────────────────────────────────────────────────────────────────────
*.tgz
.cache/
.eslintcache
